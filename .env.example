# Required data and messaging
DATABASE_URL=postgresql://polarizer:polarizer@127.0.0.1:5432/polarizer
DATABASE_MAX_CONNECTIONS=20
# Safe default for a single-instance/simple deployment. SQLx serializes
# concurrent migrators with a PostgreSQL advisory lock and startup fails if the
# migration fails. Set false only when a completed `polarizer migrate` job gates
# service startup.
POLARIZER_AUTO_MIGRATE=true
POLARIZER_MIGRATION_TIMEOUT_SECONDS=120
KAFKA_BROKERS=127.0.0.1:9092

# Required Polarizer gRPC mTLS
GRPC_TLS_CERT=/run/secrets/polarizer/tls.crt
GRPC_TLS_KEY=/run/secrets/polarizer/tls.key
GRPC_TLS_CLIENT_CA=/run/secrets/polarizer/client-ca.crt

# Required Iris mTLS authorization client
IRIS_ENDPOINT=https://iris.internal:50051
IRIS_TLS_DOMAIN=iris.internal
IRIS_TLS_CA=/run/secrets/iris/ca.crt
IRIS_TLS_CERT=/run/secrets/iris/client.crt
IRIS_TLS_KEY=/run/secrets/iris/client.key

# Required method allowlist. Keep this least-privilege in production.
SERVICE_PRINCIPAL_ALLOWLIST_JSON={"interchat-bot":["EvaluateAction","ClaimCommand","CompleteCommand","CreateRestriction","GetRestriction","UpdateRestriction","RevokeRestriction","ListRestrictions","CreateInfraction","GetInfraction","RevokeInfraction","ListInfractions","ListMyInfractions","CreateReport","GetReport","ResolveReport","CreateAppeal","GetAppeal","ResolveAppeal","GetSafetyAssessment","RecordSafetyObservation","RecalculateSafetyAssessment"],"winter":["CreatePolicyDraft","ValidatePolicy","RunPolicyTests","CreatePolicyFixture","UpdatePolicyFixture","DeletePolicyFixture","ListPolicyFixtures","SetShadowMode","PublishPolicyVersion","ApprovePolicyVersion","ActivatePolicyVersion","RollbackPolicy","ListPolicyVersions","GetExecutionTrace","ListExecutionTraces","GetProviderHealth","CreateNsfwOverride","GetNsfwOverride","ListNsfwOverrides","UpdateNsfwOverride","DeleteNsfwOverride","CreateRestriction","GetRestriction","UpdateRestriction","RevokeRestriction","ListRestrictions","CreateInfraction","GetInfraction","RevokeInfraction","ListInfractions","ListMyInfractions","CreateReport","GetReport","ListReports","ResolveReport","CreateAppeal","GetAppeal","ListAppeals","ResolveAppeal","ListReviewItems","ResolveReviewItem","GetSafetyAssessment","RecordSafetyObservation","RecalculateSafetyAssessment","GetModerationStatistics"]}
# SHA-256 of each client certificate's DER bytes. A fingerprint may belong to only one principal.
SERVICE_PRINCIPAL_CERT_SHA256_JSON={"interchat-bot":["replace-with-64-hex-characters"],"winter":["replace-with-64-hex-characters"]}

# Required: 32 random bytes encoded as 64 hexadecimal characters.
ACTION_ENCRYPTION_KEY_HEX=
ACTION_ENCRYPTION_KEY_ID=local-development

# Service addresses
HTTP_HOST=0.0.0.0
HTTP_PORT=9090
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
IRIS_TIMEOUT_MS=2000

# Kafka topics and consumer
KAFKA_ACTION_TOPIC=events.trust-safety.action.requested.v2
KAFKA_DECISION_TOPIC=events.trust-safety.decision.v2
KAFKA_COMMAND_TOPIC=events.trust-safety.commands.v2
KAFKA_COMMAND_RESULT_TOPIC=events.trust-safety.command-results.v2
KAFKA_POLICY_INVALIDATION_TOPIC=events.trust-safety.policy.invalidated.v2
KAFKA_PRISM_TOPIC=prism.stream.jobs
KAFKA_PRISM_DELIVERY_TOPIC=events.prism.delivery.v2
KAFKA_DLQ_TOPIC=events.trust-safety.action.requested.v2.dlq
KAFKA_PRISM_DELIVERY_DLQ_TOPIC=events.prism.delivery.v2.dlq
KAFKA_GROUP_ID=polarizer-v2

# Action inbox encryption and trace sampling
CLEAN_ALLOW_TRACE_SAMPLE_RATE=0.01

# Isolated Luau workers
POLARIZER_POLICY_WORKER_BIN=polarizer-policy-worker
POLICY_WORKER_COUNT=4
LUAU_SOURCE_LIMIT_BYTES=65536
LUAU_HEAP_LIMIT_BYTES=4194304
LUAU_INSTRUCTION_LIMIT=100000
LUAU_WALL_TIMEOUT_MS=25
LUAU_OUTPUT_LIMIT_BYTES=262144

# Optional OpenAI moderation provider
# OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-2024-09-26
OPENAI_CONNECT_TIMEOUT_MS=1000
OPENAI_REQUEST_TIMEOUT_MS=5000
OPENAI_MAX_CONCURRENCY=16
# Image URLs are sent only when this deployment gate and the requesting policy's
# openai.moderation configuration.external_images flag are both true.
OPENAI_EXTERNAL_IMAGES=false

# Attachment and local NSFW provider
ATTACHMENT_ALLOWED_HOSTS=cdn.discordapp.com,media.discordapp.net
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_PIXELS=40000000
# NSFW_MODEL_PATH=./quantized_model.onnx
NSFW_MODEL_INPUT_NAME=pixel_values
NSFW_MODEL_IMAGE_SIZE=224
NSFW_MODEL_MEAN=0.5,0.5,0.5
NSFW_MODEL_STD=0.5,0.5,0.5
NSFW_MODEL_LABELS=nsfw,normal
NSFW_MODEL_THREADS=4

LOG_LEVEL=info,sqlx=warn,rdkafka=warn
